# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your real tokens. Never commit .env.
# ==============================================================================

# Airtable API Authentication
# Generate PAT at: https://airtable.com/create/tokens (Requires data.records:read & data.records:write)
AIRTABLE_PAT=pat_example_token_here
AIRTABLE_BASE_ID=app_example_base_id_here
AIRTABLE_TABLE=Tickets

# Notion API Authentication (Optional for Stage 6 VoC push)
# Create internal integration at: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_example_notion_token_here
NOTION_DATABASE_ID=example_notion_database_id_here

